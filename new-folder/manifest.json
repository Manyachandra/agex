{
  "manifest_version": 3,
  "name": "Test",
  "version": "2.0",
  "description": "Double",
  "permissions": ["activeTab", "tabs", "scripting", "offscreen", "clipboardWrite"],
  "host_permissions": ["<all_urls>", "https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
